#!/usr/bin/env bash
#
# omasend-setup — install the omasend-engine binary for this plugin checkout.
#
# This script ships inside the plugin, so `omarchy plugin add` puts it on disk
# alongside the manifest and the engine source. It builds the engine from that
# source, so what you run is exactly the code you can read in this checkout —
# nothing is downloaded and there is no opaque binary to trust.
#
# Building needs Go. Without it the script stops and explains rather than
# quietly fetching a prebuilt binary; see OMASEND_ALLOW_PREBUILT below if you
# would rather have the release asset than the Go toolchain.
#
# Usage:
#   bin/omasend-setup            build and install the engine
#   bin/omasend-setup --check    report what is installed, change nothing
#
# Overrides:
#   BIN_DIR=~/bin                install somewhere other than ~/.local/bin
#   OMASEND_REPO=user/repo       download from a fork's releases
#   OMASEND_ALLOW_PREBUILT=1     opt in to the pinned release binary instead of
#                                building. Still refuses anything whose SHA-256
#                                misses engine/SHA256SUMS, but a prebuilt binary
#                                cannot be audited from this tree — which is why
#                                it is off by default.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"
BIN="$BIN_DIR/omasend-engine"
REPO="${OMASEND_REPO:-28allday/omasend-quattro}"
SUMS="$ROOT/engine/SHA256SUMS"

say() { printf '%s\n' "$*"; }
die() { printf 'omasend-setup: %s\n' "$*" >&2; exit 1; }

# The pinned version comes from the manifest, so the download can never drift
# from the code that was reviewed alongside it.
pinned_version() {
  [ -f "$ROOT/manifest.json" ] || die "manifest.json not found in $ROOT"
  if command -v jq >/dev/null 2>&1; then
    jq -r '.version // empty' "$ROOT/manifest.json"
  else
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/manifest.json" | head -1
  fi
}

asset_name() {
  case "$(uname -m)" in
    x86_64)  echo "omasend-engine-linux-amd64" ;;
    aarch64) echo "omasend-engine-linux-arm64" ;;
    *)       die "unsupported architecture $(uname -m) — install Go and re-run to build from source" ;;
  esac
}

if [ "${1:-}" = "--check" ]; then
  if [ -x "$BIN" ]; then
    say "engine: $BIN"
    exit 0
  fi
  say "engine: not installed"
  exit 1
fi

version="$(pinned_version)"
[ -n "$version" ] || die "could not read the plugin version from manifest.json"
mkdir -p "$BIN_DIR"

if command -v go >/dev/null 2>&1 && [ -f "$ROOT/go.mod" ]; then
  say "Building omasend-engine $version from source in $ROOT…"
  (cd "$ROOT" && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' \
    -o "$BIN.tmp" ./cmd/omasend-engine)
  chmod 755 "$BIN.tmp"
  mv "$BIN.tmp" "$BIN"
  say "Engine built and installed: $BIN"
  exit 0
fi

# No Go. Building is the only path that is auditable from this checkout, so
# stop here unless the user has explicitly chosen otherwise.
if [ "${OMASEND_ALLOW_PREBUILT:-}" != "1" ]; then
  die "Go is required to build the engine, and it is not installed.

The engine is built from the source in this checkout so that what runs is
exactly the code you can read here. Either install Go and re-run:

  sudo pacman -S go
  $0

or, if you would rather not install a toolchain, opt in to the prebuilt
release binary — pinned to v$version and checked against engine/SHA256SUMS,
but not something you can audit from this tree:

  OMASEND_ALLOW_PREBUILT=1 $0"
fi

say "Using the prebuilt release binary at your request (OMASEND_ALLOW_PREBUILT=1)."
asset="$(asset_name)"
url="https://github.com/$REPO/releases/download/v$version/$asset"

[ -f "$SUMS" ] || die "engine/SHA256SUMS is missing — refusing to install an unverified binary"
want="$(awk -v a="$asset" '$2 == a || $2 == "*"a {print $1}' "$SUMS" | head -1)"
[ -n "$want" ] || die "no SHA-256 recorded for $asset in engine/SHA256SUMS"

say "Downloading pinned engine v$version ($asset)…"
tmp="$BIN.download.$$"
trap 'rm -f "$tmp"' EXIT
curl -fsSL -o "$tmp" "$url" || die "download failed: $url"

got="$(sha256sum "$tmp" | awk '{print $1}')"
if [ "$got" != "$want" ]; then
  die "checksum mismatch for $asset
  expected $want
  got      $got
The download does not match the checksum committed in this checkout — nothing
was installed. Report this, or install Go and re-run to build from source."
fi

chmod 755 "$tmp"
mv "$tmp" "$BIN"
trap - EXIT
say "Engine installed and checksum-verified: $BIN"
